# ─── Tenant Configuration ─────────────────────────────────────────────────────
# The tenant ID for this marketplace instance. Must match the tenant_id in
# knowledge_base.agent_configs (api-v2 DB) so the AI Configuration in
# Whitelabel > AI Configuration is used as the source of truth for AI features.
NEXT_PUBLIC_TENANT_ID=41
NEXT_PUBLIC_TENANT_NAME="Hayahai"

# ─── Client API (ayahay-client-api) ───────────────────────────────────────────
# Used when NEXT_PUBLIC_IS_CLIENT=true
# Base URL of the client-facing REST API (trips, routes, bookings, rates, etc.)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Used when NEXT_PUBLIC_IS_CLIENT=false
NEXT_PUBLIC_API_URL=http://localhost:3002

# ─── Whitelabel Mode ──────────────────────────────────────────────────────────
# true  = client/whitelabel mode (use tenant branding from client-api)
# false = default Ayahay branding
NEXT_PUBLIC_IS_CLIENT=false
